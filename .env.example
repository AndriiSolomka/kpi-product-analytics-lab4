# ──────────────────────────────────────────────────────────────
# Варіант 1. Локальна модель (нічого не коштує, ключ не потрібен)
# ──────────────────────────────────────────────────────────────
# Ollama:
DATAPILOT_PROVIDER=ollama
DATAPILOT_MODEL=llama3.1
# DATAPILOT_BASE_URL=http://localhost:11434/v1   # підставляється автоматично

# LM Studio:
# DATAPILOT_PROVIDER=lmstudio
# DATAPILOT_MODEL=local-model
# DATAPILOT_BASE_URL=http://localhost:1234/v1

# Будь-який інший сервер з OpenAI-сумісним API (llama.cpp, vLLM, text-generation-webui):
# DATAPILOT_BASE_URL=http://localhost:8000/v1
# DATAPILOT_MODEL=назва-моделі

# ──────────────────────────────────────────────────────────────
# Варіант 2. Хмарний API
# ──────────────────────────────────────────────────────────────
# Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# DATAPILOT_MODEL=claude-sonnet-4-5

# OpenAI:
# OPENAI_API_KEY=sk-...
# DATAPILOT_PROVIDER=openai
# DATAPILOT_MODEL=gpt-4o-mini
